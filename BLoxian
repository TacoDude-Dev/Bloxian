<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bloxian</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #222;
        }

        /* TOP BAR */

        .topbar {
            height: 60px;
            background: #191919;
            color: white;
            display: flex;
            align-items: center;
            padding: 0 22px;
            gap: 25px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            cursor: pointer;
        }

        .search {
            width: 330px;
            height: 36px;
            background: #303030;
            border: 1px solid #444;
            border-radius: 6px;
            color: white;
            padding: 0 14px;
            outline: none;
        }

        .search:focus {
            border-color: white;
        }

        .search::placeholder {
            color: #aaa;
        }

        .top-links {
            display: flex;
            gap: 22px;
            margin-left: auto;
        }

        .top-links button {
            background: none;
            border: none;
            color: #ddd;
            cursor: pointer;
            font-size: 14px;
        }

        .top-links button:hover {
            color: white;
        }

        .login {
            background: white;
            color: #222;
            border: none;
            border-radius: 5px;
            padding: 9px 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .login:hover {
            background: #ddd;
        }

        /* SIDEBAR */

        .sidebar {
            width: 210px;
            min-height: calc(100vh - 60px);
            background: white;
            border-right: 1px solid #ddd;
            padding: 22px 12px;
            position: fixed;
            top: 60px;
            left: 0;
        }

        .sidebar-title {
            font-size: 11px;
            color: #888;
            font-weight: bold;
            padding: 0 12px 10px;
            text-transform: uppercase;
        }

        .side-button {
            width: 100%;
            background: none;
            border: none;
            text-align: left;
            padding: 12px;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
            margin-bottom: 2px;
        }

        .side-button:hover {
            background: #eee;
        }

        .side-button.active {
            background: #e9e9e9;
            font-weight: bold;
        }

        /* MAIN */

        .main {
            margin-left: 210px;
            width: calc(100% - 210px);
            padding: 35px;
        }

        .welcome {
            margin-bottom: 35px;
        }

        .welcome h1 {
            font-size: 30px;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #777;
        }

        /* SECTIONS */

        .section {
            margin-bottom: 40px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .section-header h2 {
            font-size: 21px;
        }

        .see-all {
            background: none;
            border: none;
            color: #666;
            font-size: 14px;
            cursor: pointer;
        }

        .see-all:hover {
            color: #111;
        }

        /* GAMES */

        .games {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 20px;
        }

        .game {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #ddd;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
        }

        .game:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(0,0,0,0.12);
        }

        .thumbnail {
            height: 130px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 55px;
        }

        .thumb1 { background: #b8d8ff; }
        .thumb2 { background: #c9f0c2; }
        .thumb3 { background: #ffd6a5; }
        .thumb4 { background: #d8c2ff; }
        .thumb5 { background: #ffc2d1; }
        .thumb6 { background: #c2f0f0; }

        .game-info {
            padding: 12px;
        }

        .game-name {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .creator {
            font-size: 12px;
            color: #777;
            margin-bottom: 10px;
        }

        .players {
            font-size: 12px;
            color: #555;
        }

        .play-button {
            width: 100%;
            margin-top: 10px;
            border: none;
            border-radius: 5px;
            background: #222;
            color: white;
            padding: 9px;
            cursor: pointer;
            font-weight: bold;
        }

        .play-button:hover {
            background: #444;
        }

        /* EMPTY / SEARCH */

        .message {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 35px;
            text-align: center;
            color: #777;
            display: none;
        }

        /* MODAL */

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 500;
            align-items: center;
            justify-content: center;
        }

        .modal-box {
            background: white;
            width: 400px;
            max-width: 90%;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.25);
        }

        .modal-box h2 {
            margin-bottom: 10px;
        }

        .modal-box p {
            color: #666;
            margin-bottom: 20px;
        }

        .modal-input {
            width: 100%;
            padding: 11px;
            border: 1px solid #ccc;
            border-radius: 6px;
            margin-bottom: 12px;
            outline: none;
        }

        .modal-button {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 6px;
            background: #222;
            color: white;
            font-weight: bold;
            cursor: pointer;
            margin-top: 5px;
        }

        .close-button {
            width: 100%;
            padding: 10px;
            border: none;
            background: #eee;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 8px;
        }

        /* MOBILE */

        @media (max-width: 800px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                width: 100%;
            }

            .search {
                width: 180px;
            }

            .top-links {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- TOP BAR -->

    <nav class="topbar">

        <div class="logo" onclick="goHome()">
            BLOXIAN
        </div>

        <input
            id="search"
            class="search"
            type="text"
            placeholder="Search games..."
            oninput="searchGames()"
        >

        <div class="top-links">

            <button onclick="showDiscover()">
                Discover
            </button>

            <button onclick="createGame()">
                Create
            </button>

            <button onclick="showProfile()">
                Avatar
            </button>

        </div>

        <button class="login" onclick="login()">
            Log In
        </button>

    </nav>


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="sidebar-title">
            Navigation
        </div>

        <button class="side-button active" onclick="goHome()">
            🏠 Home
        </button>

        <button class="side-button" onclick="showPopular()">
            🔥 Popular
        </button>

        <button class="side-button" onclick="showFavorites()">
            ⭐ Favorites
        </button>

        <button class="side-button" onclick="showProfile()">
            👤 Profile
        </button>

        <br>

        <div class="sidebar-title">
            Create
        </div>

        <button class="side-button" onclick="createGame()">
            🛠️ Create Game
        </button>

        <button class="side-button" onclick="showMyGames()">
            📦 My Games
        </button>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <div class="welcome">

            <h1 id="pageTitle">
                Discover
            </h1>

            <p id="pageDescription">
                Find your next favorite game.
            </p>

        </div>


        <section class="section">

            <div class="section-header">

                <h2 id="sectionTitle">
                    🔥 Popular Games
                </h2>

                <button class="see-all" onclick="showAllGames()">
                    See All →
                </button>

            </div>


            <div class="games" id="games">

                <!-- GAME 1 -->

                <div class="game"
                     data-name="Anime Seas"
                     data-favorite="true">

                    <div class="thumbnail thumb1">
                        🏝️
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            Anime Seas
                        </div>

                        <div class="creator">
                            By Taco Studios
                        </div>

                        <div class="players">
                            👥 12.4K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'Anime Seas')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>


                <!-- GAME 2 -->

                <div class="game"
                     data-name="Speed Race"
                     data-favorite="true">

                    <div class="thumbnail thumb2">
                        🏃
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            Speed Race
                        </div>

                        <div class="creator">
                            By Taco Studios
                        </div>

                        <div class="players">
                            👥 8.2K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'Speed Race')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>


                <!-- GAME 3 -->

                <div class="game"
                     data-name="Fish World"
                     data-favorite="false">

                    <div class="thumbnail thumb3">
                        🎣
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            Fish World
                        </div>

                        <div class="creator">
                            By OceanDev
                        </div>

                        <div class="players">
                            👥 6.7K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'Fish World')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>


                <!-- GAME 4 -->

                <div class="game"
                     data-name="Battle Arena"
                     data-favorite="true">

                    <div class="thumbnail thumb4">
                        ⚔️
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            Battle Arena
                        </div>

                        <div class="creator">
                            By ArenaDev
                        </div>

                        <div class="players">
                            👥 5.1K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'Battle Arena')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>


                <!-- GAME 5 -->

                <div class="game"
                     data-name="City Drive"
                     data-favorite="false">

                    <div class="thumbnail thumb5">
                        🚗
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            City Drive
                        </div>

                        <div class="creator">
                            By DriveDev
                        </div>

                        <div class="players">
                            👥 3.4K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'City Drive')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>


                <!-- GAME 6 -->

                <div class="game"
                     data-name="World Explorer"
                     data-favorite="false">

                    <div class="thumbnail thumb6">
                        🌎
                    </div>

                    <div class="game-info">

                        <div class="game-name">
                            World Explorer
                        </div>

                        <div class="creator">
                            By ExplorerDev
                        </div>

                        <div class="players">
                            👥 2.8K playing
                        </div>

                        <button
                            class="play-button"
                            onclick="play(event, 'World Explorer')"
                        >
                            ▶ Play
                        </button>

                    </div>

                </div>

            </div>

            <div class="message" id="message">
                Nothing here yet.
            </div>

        </section>

    </main>


    <!-- MODAL -->

    <div class="modal" id="modal">

        <div class="modal-box">

            <h2 id="modalTitle">
                Bloxian
            </h2>

            <p id="modalText">
                Welcome!
            </p>

            <div id="modalContent"></div>

            <button
                class="close-button"
                onclick="closeModal()"
            >
                Close
            </button>

        </div>

    </div>


    <script>

        /* -------------------------
           MODAL
        ------------------------- */

        function openModal(title, text, content = "") {

            document.getElementById("modalTitle").textContent = title;

            document.getElementById("modalText").textContent = text;

            document.getElementById("modalContent").innerHTML = content;

            document.getElementById("modal").style.display = "flex";
        }


        function closeModal() {

            document.getElementById("modal").style.display = "none";

        }


        /* -------------------------
           PLAY GAME
        ------------------------- */

        function play(event, gameName) {

            event.stopPropagation();

            openModal(
                "🎮 " + gameName,
                "Preparing your game...",
                `
                    <button
                        class="modal-button"
                        onclick="launchGame('${gameName}')"
                    >
                        ▶ Launch Game
                    </button>
                `
            );

        }


        function launchGame(gameName) {

            /*
                THIS IS WHERE OUR REAL GAME LAUNCHER
                WILL EVENTUALLY GO.

                For now it shows that the button works.
            */

            openModal(
                "🚀 Launching...",
                gameName + " is ready to launch!",
                `
                    <p>
                        The desktop launcher will be connected here.
                    </p>
                `
            );

        }


        /* -------------------------
           LOGIN
        ------------------------- */

        function login() {

            openModal(
                "Log In",
                "Sign in to your Bloxian account.",
                `
                    <input
                        class="modal-input"
                        placeholder="Username"
                    >

                    <input
                        class="modal-input"
                        type="password"
                        placeholder="Password"
                    >

                    <button
                        class="modal-button"
                        onclick="fakeLogin()"
                    >
                        Log In
                    </button>
                `
            );

        }


        function fakeLogin() {

            openModal(
                "✅ Logged In",
                "You are now logged in!",
                `
                    <p>
                        Account system will be connected later.
                    </p>
                `
            );

        }


        /* -------------------------
           SEARCH
        ------------------------- */

        function searchGames() {

            const search =
                document
                .getElementById("search")
                .value
                .toLowerCase();

            const games =
                document.querySelectorAll(".game");

            let found = 0;

            games.forEach(game => {

                const name =
                    game.dataset.name.toLowerCase();

                if (name.includes(search)) {

                    game.style.display = "";

                    found++;

                } else {

                    game.style.display = "none";

                }

            });

            const message =
                document.getElementById("message");

            if (found === 0) {

                message.style.display = "block";

                message.textContent =
                    "🔎 No games found.";

            } else {

                message.style.display = "none";

            }

        }


        /* -------------------------
           HOME
        ------------------------- */

        function goHome() {

            document.getElementById("pageTitle").textContent =
                "Discover";

            document.getElementById("pageDescription").textContent =
                "Find your next favorite game.";

            document.getElementById("sectionTitle").textContent =
                "🔥 Popular Games";

            showAllGames();

        }


        /* -------------------------
           DISCOVER
        ------------------------- */

        function showDiscover() {

            goHome();

        }


        /* -------------------------
           POPULAR
        ------------------------- */

        function showPopular() {

            document.getElementById("pageTitle").textContent =
                "Popular";

            document.getElementById("pageDescription").textContent =
                "Games people are playing right now.";

            document.getElementById("sectionTitle").textContent =
                "🔥 Popular Games";

            showAllGames();

        }


        /* -------------------------
           FAVORITES
        ------------------------- */

        function showFavorites() {

            const games =
                document.querySelectorAll(".game");

            let found = 0;

            games.forEach(game => {

                if (game.dataset.favorite === "true") {

                    game.style.display = "";

                    found++;

                } else {

                    game.style.display = "none";

                }

            });

            document.getElementById("pageTitle").textContent =
                "Favorites";

            document.getElementById("pageDescription").textContent =
                "Your favorite games.";

            document.getElementById("sectionTitle").textContent =
                "⭐ Favorite Games";

            const message =
                document.getElementById("message");

            message.style.display = "none";

        }


        /* -------------------------
           PROFILE
        ------------------------- */

        function showProfile() {

            openModal(
                "👤 Profile",
                "Your Bloxian profile",
                `
                    <p><b>Username:</b> TacoDude</p>
                    <p><b>Games:</b> 0</p>
                    <p><b>Followers:</b> 0</p>
                `
            );

        }


        /* -------------------------
           CREATE
        ------------------------- */

        function createGame() {

            openModal(
                "🛠️ Create Game",
                "Create your own game.",
                `
                    <input
                        class="modal-input"
                        placeholder="Game name"
                    >

                    <button
                        class="modal-button"
                        onclick="createFakeGame()"
                    >
                        Create Game
                    </button>
                `
            );

        }


        function createFakeGame() {

            openModal(
                "🎮 You finally created a game LOL XDDDDDDD",
                "Your game has been created!",
                `
                    <p>
                        Later we can connect this
                        to your actual game editor.
                    </p>
                `
            );

        }


        /* -------------------------
           MY GAMES
        ------------------------- */

        function showMyGames() {

            document.getElementById("pageTitle").textContent =
                "My Games";

            document.getElementById("pageDescription").textContent =
                "Games you've created.";

            document.getElementById("sectionTitle").textContent =
                "📦Creation";

            const games =
                document.querySelectorAll(".game");

            games.forEach(game => {

                game.style.display = "none";

            });

            document.getElementById("message").style.display =
                "block";

            document.getElementById("message").textContent =
                "📦 You haven't created any games yet.";

        }


        /* -------------------------
           SEE ALL
        ------------------------- */

        function showAllGames() {

            const games =
                document.querySelectorAll(".game");

            games.forEach(game => {

                game.style.display = "";

            });

            document.getElementById("message").style.display =
                "none";

        }


        /* -------------------------
           CLOSE MODAL WHEN CLICKING
           OUTSIDE THE BOX
        ------------------------- */

        document.getElementById("modal").addEventListener(
            "click",
            function(event) {

                if (event.target === this) {

                    closeModal();

                }

            }
        );

    </script>

</body>
</html>
